rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function tokenSchoolId() {
      return request.auth.token.schoolId;
    }

    function hasTenantContext() {
      return isSignedIn()
        && request.auth.token.schoolId is string
        && request.auth.token.role is string;
    }

    function isSchoolMember(schoolId) {
      return (hasTenantContext() && tokenSchoolId() == schoolId)
        || (isSignedIn() && get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.schoolId == schoolId);
    }

    function hasRole(role) {
      return hasTenantContext() && request.auth.token.role == role;
    }

    function hasPermission(permission) {
      return hasTenantContext()
        && request.auth.token.permissions is list
        && request.auth.token.permissions.hasAny([permission]);
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isParent() {
      return hasRole('parent');
    }

    function parentOwnsStudent(studentId) {
      return isParent()
        && exists(
          /databases/$(database)/documents/schools/$(request.auth.token.schoolId)/parents/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/schools/$(request.auth.token.schoolId)/parents/$(request.auth.uid)
        ).data.studentIds.hasAny([studentId]);
    }

    match /schools/{schoolId} {
      allow read: if isSchoolMember(schoolId);
      allow write: if false;

      match /info/{documentId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin();
      }

      match /students/{studentId} {
        allow read: if isAdmin() || isTeacher() || parentOwnsStudent(studentId);
        allow write: if isAdmin();
      }

      match /teachers/{teacherId} {
        allow read: if isAdmin() || (isTeacher() && request.auth.uid == teacherId);
        allow write: if isAdmin();
      }

      match /parents/{parentId} {
        allow read: if isAdmin() || (isParent() && request.auth.uid == parentId);
        allow write: if isAdmin();
      }

      match /classes/{classId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || isTeacher();
      }

      match /timetables/{documentId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || isTeacher();
      }

      match /fee_records/{recordId} {
        allow read: if isAdmin() || parentOwnsStudent(resource.data.studentId);
        allow write: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || isTeacher();
      }

      match /notification_preferences/{userId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow write: if request.auth.uid == userId || isAdmin();
      }

      match /notification_tokens/{userId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow write: if request.auth.uid == userId
          && request.resource.data.schoolId == schoolId
          && request.resource.data.userId == request.auth.uid;
      }

      match /calendar_events/{eventId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || isTeacher();
      }

      match /calendar/{eventId} {
        allow read: if isSchoolMember(schoolId);
        allow create: if (isAdmin() || isTeacher())
          && request.resource.data.schoolId == schoolId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isAdmin() || isTeacher())
          && resource.data.schoolId == schoolId
          && request.resource.data.schoolId == schoolId;
        allow delete: if isAdmin() || isTeacher();
      }

      match /conversations/{conversationId} {
        allow read: if isSchoolMember(schoolId) && resource.data.participants.hasAny([request.auth.uid]);
        allow create: if isSchoolMember(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.participants.hasAny([request.auth.uid]);
        allow update: if isSchoolMember(schoolId)
          && resource.data.participants.hasAny([request.auth.uid]);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isSchoolMember(schoolId)
            && get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
          allow create: if isSchoolMember(schoolId)
            && request.resource.data.senderId == request.auth.uid
            && get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
          allow update: if isSchoolMember(schoolId)
            && get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
          allow delete: if false;
        }

        match /typing/{typingId} {
          allow read: if isSchoolMember(schoolId)
            && get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
          allow write: if isSchoolMember(schoolId)
            && get(/databases/$(database)/documents/schools/$(schoolId)/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        }
      }

      match /payments/{paymentId} {
        allow read: if isAdmin() || hasPermission('canManagePayments');
        allow write: if false;
      }

      match /payment_transactions/{transactionId} {
        allow read: if isAdmin()
          || (isParent() && resource.data.parentId == request.auth.uid)
          || hasPermission('canManagePayments');
        allow write: if false;
      }

      match /fee_invoices/{invoiceId} {
        allow read: if isAdmin()
          || (isParent() && resource.data.parentId == request.auth.uid)
          || hasPermission('canManagePayments');
        allow write: if isAdmin() || hasPermission('canManagePayments');
      }

      match /sports/{documentId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageSports');
      }

      match /culture/{documentId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageCulture');
      }

      match /teams/{teamId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageSports') || hasPermission('canManageCulture');
      }

      match /events/{eventId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageSports') || hasPermission('canManageCulture');
      }

      match /awards/{awardId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canPublishAwards');
      }

      match /achievements/{achievementId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canPublishAwards');
      }

      match /student_recognition/{recognitionId} {
        allow read: if isAdmin()
          || isTeacher()
          || (isParent() && parentOwnsStudent(resource.data.studentId));
        allow write: if isAdmin() || hasPermission('canPublishAwards');
      }

      match /lunch_menus/{menuId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageLunch');
      }

      match /daily_meals/{mealId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || hasPermission('canManageLunch');
      }

      match /attendance/{attendanceId} {
        allow read: if isAdmin()
          || isTeacher()
          || (isParent() && parentOwnsStudent(resource.data.studentId));
        allow create, update: if isAdmin() || isTeacher();
        allow delete: if isAdmin();
      }

      match /class_registers/{registerId} {
        allow read: if isSchoolMember(schoolId);
        allow write: if isAdmin() || isTeacher();
      }
    }

    match /user_profiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /schools_directory/{schoolId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
